/*
===============================================================================
GOLD LAYER - DIMENSIONAL MODEL VIEWS
===============================================================================
Purpose: Creates business-friendly views for reporting and analytics
Source: data_warehouse schema (silver layer tables)
===============================================================================
*/

-- Create and use the gold database
CREATE DATABASE IF NOT EXISTS gold;
USE gold;

-- ============================================================================
-- DIMENSION: CUSTOMERS
-- ============================================================================
-- Combines customer information from CRM and ERP systems
-- Handles gender data from multiple sources with fallback logic

DROP VIEW IF EXISTS dim_customers;
CREATE VIEW dim_customers AS
SELECT
    ci.cst_id                          AS customer_key,
    ci.cst_id                          AS customer_id,
    ci.cst_key                         AS customer_number,
    ci.cst_firstname                   AS first_name,
    ci.cst_lastname                    AS last_name,
    la.cntry                           AS country,
    ci.cst_marital_status              AS marital_status,
    -- Use CRM gender if available, otherwise fall back to ERP gender
    CASE 
        WHEN ci.cst_gndr != 'n/a' THEN ci.cst_gndr
        ELSE COALESCE(ca.gen, 'n/a')
    END                                AS gender,
    ca.bdate                           AS birthdate,
    ci.cst_create_date                 AS create_date
FROM data_warehouse.silver_crm_cust_info ci
LEFT JOIN data_warehouse.silver_erp_cust_az12 ca ON ci.cst_key = ca.cid
LEFT JOIN data_warehouse.silver_erp_loc_a101 la ON ci.cst_key = la.cid;

-- ============================================================================
-- DIMENSION: PRODUCTS
-- ============================================================================
-- Product catalog with category information
-- Only includes active products (no end date)

DROP VIEW IF EXISTS dim_products;
CREATE VIEW dim_products AS
SELECT
    pn.prd_id       AS product_key,
    pn.prd_id       AS product_id,
    pn.prd_key      AS product_number,
    pn.prd_nm       AS product_name,
    pn.cat_id       AS category_id,
    pc.cat          AS category,
    pc.subcat       AS subcategory,
    pc.maintenance  AS maintenance,
    pn.prd_cost     AS cost,
    pn.prd_line     AS product_line,
    pn.prd_start_dt AS start_date
FROM data_warehouse.silver_crm_prd_info pn
LEFT JOIN data_warehouse.silver_erp_px_cat_g1v2 pc ON pn.cat_id = pc.id
WHERE pn.prd_end_dt IS NULL;  -- Active products only

-- ============================================================================
-- FACT TABLE: SALES
-- ============================================================================
-- Sales transactions with product and customer references
-- Links to dimension tables via product_key and customer_key

DROP VIEW IF EXISTS fact_sales;
CREATE VIEW fact_sales AS
SELECT
    sd.sls_ord_num  AS order_number,
    pn.prd_id       AS product_key,
    ci.cst_id       AS customer_key,
    sd.sls_order_dt AS order_date,
    sd.sls_ship_dt  AS shipping_date,
    sd.sls_due_dt   AS due_date,
    sd.sls_sales    AS sales_amount,
    sd.sls_quantity AS quantity,
    sd.sls_price    AS price
FROM data_warehouse.silver_crm_sales_details sd
LEFT JOIN data_warehouse.silver_crm_prd_info pn 
    ON sd.sls_prd_key = pn.prd_key 
    AND pn.prd_end_dt IS NULL  -- Match only active products
LEFT JOIN data_warehouse.silver_crm_cust_info ci 
    ON sd.sls_cust_id = ci.cst_id;

-- ============================================================================
-- VERIFICATION QUERY
-- ============================================================================
-- Returns row counts for all views to confirm successful creation

SELECT 'dim_customers' AS view_name, COUNT(*) AS row_count FROM dim_customers
UNION ALL
SELECT 'dim_products', COUNT(*) FROM dim_products
UNION ALL
SELECT 'fact_sales', COUNT(*) FROM fact_sales;
